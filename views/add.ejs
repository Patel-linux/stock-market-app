<h2>Add Stock to Watchlist</h2>

<form method="post" action="/stocks/add" class="form">
  <label>Symbol
    <input name="symbol" placeholder="AAPL" required />
  </label>
  <label>Name (optional)
    <input name="name" placeholder="Apple Inc." />
  </label>
  <label>Note
    <input name="note" />
  </label>
  <button class="btn">Add</button>
</form>
